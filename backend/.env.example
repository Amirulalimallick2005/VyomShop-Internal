# PostgreSQL Database Connection URL (Supabase, Neon, AWS RDS, or local Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vyom_shop?schema=public"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# In Flutter, configure firebase_core & firebase_auth with google_sign_in & phone verification.
# The mobile app sends the Firebase ID token via HTTP header:
# Authorization: Bearer <firebase_id_token>
FIREBASE_PROJECT_ID="vyom-shops-delhi"
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Admin Session Secret for Web Refine Dashboard
ADMIN_JWT_SECRET="vyom_shops_admin_super_secret_jwt_key_2026_xyz"
INITIAL_ADMIN_EMAIL="admin@vyomshops.com"
INITIAL_ADMIN_PASSWORD="SuperAdmin@123"
INITIAL_ADMIN_UID="super_admin_vyom_firebase_uid"

RAZORPAY_KEY_ID="rzp_test_vyomshop123"
RAZORPAY_KEY_SECRET="rzp_test_secret_abc123"
