# PostgreSQL Database Connection URL (Supabase, Neon, AWS RDS, or local Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vyom_shop?schema=public"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Firebase Client SDK (for Seller Dashboard login — safe to expose publicly)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="vyom-shops-delhi.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="vyom-shops-delhi"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="vyom-shops-delhi.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# In Flutter, configure firebase_core & firebase_auth with google_sign_in & phone verification.
# The mobile app sends the Firebase ID token via HTTP header:
# Authorization: Bearer <firebase_id_token>
FIREBASE_PROJECT_ID="vyom-shops-delhi"
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Admin Session Secret for Web Refine Dashboard
ADMIN_JWT_SECRET="vyom_shops_admin_super_secret_jwt_key_2026_xyz"
INITIAL_ADMIN_EMAIL="admin@vyomshops.com"
INITIAL_ADMIN_PASSWORD="SuperAdmin@123"
INITIAL_ADMIN_UID="super_admin_vyom_firebase_uid"

RAZORPAY_KEY_ID="rzp_test_vyomshop123"
RAZORPAY_KEY_SECRET="rzp_test_secret_abc123"

S3_ENDPOINT="" # Optional: Leave empty for AWS S3, or set custom endpoint (e.g., https://your-account-id.r2.cloudflarestorage.com)
S3_REGION="auto" # AWS region (e.g., us-east-1) or "auto" for Cloudflare R2
S3_BUCKET_NAME="vyom-shop-uploads"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL="" # Optional: Public URL for accessing files (e.g., https://cdn.yourdomain.com or https://pub-xxxxx.r2.dev)
